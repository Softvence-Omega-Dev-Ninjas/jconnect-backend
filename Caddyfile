api.theconnectapp.net {

  reverse_proxy /socket.io* app:5050

  @api {
    not path /socket.io*
  }

  handle @api {
    request_body {
      max_size 500MB
    }

    reverse_proxy app:5050 {
      header_up X-Real-IP {remote}
      header_up X-Forwarded-For {remote}
      header_up X-Forwarded-Proto {scheme}
      header_up Host {host}
    }
  }
}